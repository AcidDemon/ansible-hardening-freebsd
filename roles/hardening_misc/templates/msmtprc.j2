# Managed by Ansible
defaults
tls on
tls_starttls on
auth on
logfile /var/log/msmtp.log
# msmtp does no alias expansion of its own and ignores /etc/mail/aliases, so
# without this, mail addressed to "root" is handed to the relay verbatim.
aliases /usr/local/etc/aliases

account default
host {{ smtp_host }}
port {{ smtp_port | default(587) }}
from {{ smtp_from }}
user {{ vault_smtp_user }}
password {{ vault_smtp_password }}
