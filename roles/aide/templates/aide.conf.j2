# Managed by Ansible
# database_in, not database: AIDE 0.19 removed the old name and rejects it with
# "unexpected character". Values must be URLs, so a bare path fails too with
# "unknown URL-type" - hence file:// followed by the absolute path.
database_in=file:///var/db/aide/aide.db
database_out=file:///var/db/aide/aide.db.new
database_new=file:///var/db/aide/aide.db.new
gzip_dbout=no

Checksums = sha256+sha512
NORMAL = p+i+n+u+g+s+m+c+Checksums
DIR = p+i+n+u+g

/etc            NORMAL
/boot           NORMAL
/bin            NORMAL
/sbin           NORMAL
/lib            NORMAL
/libexec        NORMAL
/usr/bin        NORMAL
/usr/sbin       NORMAL
/usr/lib        NORMAL
/usr/local/etc  NORMAL
/usr/local/bin  NORMAL
/usr/local/sbin NORMAL

{% for p in aide_exclude_paths %}
!{{ p }}
{% endfor %}
