# Managed by Ansible
{% if ssh_2fa_totp_enabled %}
KbdInteractiveAuthentication yes
AuthenticationMethods publickey,keyboard-interactive
{% else %}
AuthenticationMethods publickey
{% endif %}
{% set _exempt_users = (ssh_2fa_exempt_users + [deploy_user | default('')]) | select('string') | reject('equalto', '') | unique %}
{% if ssh_2fa_deploy_from | length > 0 %}

# Key-only and NOPASSWD, so pinned to ssh_2fa_deploy_from. AllowUsers refuses any
# other source before authentication starts, whatever nullok says.
Match User {{ deploy_user }}
    AllowUsers {{ deploy_user }}@{{ ssh_2fa_deploy_from | join(' ' ~ deploy_user ~ '@') }}
{% endif %}
{% if _exempt_users | length > 0 %}

# Key-only accounts. The fido2users block below excludes them as well.
Match User {{ _exempt_users | join(',') }}
    AuthenticationMethods publickey
{% endif %}
{% for g in ssh_2fa_exempt_groups %}

Match Group {{ g }}
    AuthenticationMethods publickey
{% endfor %}
{% if ssh_2fa_fido2_enabled %}

Match Group fido2users User *{% for u in _exempt_users %},!{{ u }}{% endfor +%}
    AuthenticationMethods publickey
    PubkeyAuthOptions verify-required
    PubkeyAcceptedAlgorithms sk-ssh-ed25519@openssh.com
{% endif %}

# Leave the file at top level rather than inside the last Match block above.
# Current OpenSSH restores the includer's match context after an Include, so
# this is belt-and-braces, not a fix - older versions did leak, and it keeps the
# drop-in self-contained for anything that concatenates rather than includes.
Match all
