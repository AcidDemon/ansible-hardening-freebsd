# Managed by Ansible. pf backend fills the <sshguard> table base pre-declares.
BACKEND="/usr/local/libexec/sshg-fw-pf"
THRESHOLD={{ sshguard_threshold }}
BLOCK_TIME={{ sshguard_blocktime }}
DETECTION_TIME={{ sshguard_detection_time }}
WHITELIST_FILE=/usr/local/etc/sshguard.whitelist
# FreeBSD sshd logs to /var/log/auth.log via syslog. -q matters once there is
# more than one path: tail prints "==> name <==" headers otherwise and the
# parser chokes on them.
LOGREADER="LANG=C /usr/bin/tail -qF -n0 {{ sshguard_log_paths | join(' ') }}"
